safety_incidence
safety_table <- safety_incidence %>%
mutate(
TEAE_n_pct = sprintf(
"%d (%.1f%%)",
TEAE,
TEAE_PCT
),
GRADE3PLUS_n_pct = sprintf(
"%d (%.1f%%)",
GRADE3PLUS,
GRADE3PLUS_PCT
),
SERIOUS_n_pct = sprintf(
"%d (%.1f%%)",
SERIOUS,
SERIOUS_PCT
),
RELATED_n_pct = sprintf(
"%d (%.1f%%)",
RELATED,
RELATED_PCT
)
) %>%
select(
TRT01A,
N,
TEAE_n_pct,
GRADE3PLUS_n_pct,
SERIOUS_n_pct,
RELATED_n_pct
)
safety_table
write_csv(
safety_table,
here(
"output",
"tables",
"03_key_safety_incidence.csv"
)
)
cat(
"Saved: output/tables/03_key_safety_incidence.csv\n"
)
stopifnot(
all(
safety_incidence$TEAE ==
c(30, 31, 34)
)
)
stopifnot(
all(
safety_incidence$GRADE3PLUS ==
c(15, 12, 21)
)
)
stopifnot(
all(
safety_incidence$SERIOUS ==
c(15, 12, 21)
)
)
stopifnot(
all(
safety_incidence$RELATED ==
c(20, 26, 23)
)
)
stopifnot(
all(
safety_incidence$TEAE <= safety_incidence$N
)
)
stopifnot(
all(
safety_incidence$GRADE3PLUS <= safety_incidence$TEAE
)
)
stopifnot(
all(
safety_incidence$SERIOUS <= safety_incidence$TEAE
)
)
stopifnot(
all(
safety_incidence$RELATED <= safety_incidence$TEAE
)
)
cat("Key safety incidence QC PASSED\n")
safety_plot_data <- safety_incidence %>%
select(
TRT01A,
TEAE_PCT,
GRADE3PLUS_PCT,
SERIOUS_PCT,
RELATED_PCT
) %>%
pivot_longer(
cols = -TRT01A,
names_to = "Endpoint",
values_to = "Percentage"
) %>%
mutate(
Endpoint = recode(
Endpoint,
TEAE_PCT = "Any TEAE",
GRADE3PLUS_PCT = "Grade ≥3 TEAE",
SERIOUS_PCT = "Serious TEAE",
RELATED_PCT = "Related TEAE"
)
)
safety_plot_data
safety_plot <- ggplot(
safety_plot_data,
aes(
x = TRT01A,
y = Percentage,
fill = Endpoint
)
) +
geom_col(
position = position_dodge(
width = 0.8
),
width = 0.7
) +
geom_text(
aes(
label = sprintf(
"%.1f%%",
Percentage
)
),
position = position_dodge(
width = 0.8
),
vjust = -0.3,
size = 3
) +
scale_y_continuous(
limits = c(0, 100),
breaks = seq(0, 100, 20),
expand = expansion(
mult = c(0, 0.08)
)
) +
labs(
title = "Key Safety Event Incidence by Treatment",
x = "Treatment",
y = "Patients with Event (%)",
fill = "Safety Endpoint"
) +
theme_minimal(
base_size = 13
)
safety_plot
ggsave(
filename = here(
"output",
"figures",
"02_safety_event_incidence.png"
),
plot = safety_plot,
width = 10,
height = 6,
dpi = 300
)
cat(
"Figure 2 saved: output/figures/02_safety_event_incidence.png\n"
)
stopifnot(
file.exists(
here(
"output",
"figures",
"02_safety_event_incidence.png"
)
)
)
cat("Figure 2 QC PASSED\n")
safety_counts
safety_table
teae_terms <- adae %>%
filter(
TRTEMFL == "Y"
) %>%
count(
AEDECOD,
name = "EVENTS"
) %>%
arrange(
desc(EVENTS)
)
teae_terms
teae_term_patients <- adae %>%
filter(
TRTEMFL == "Y"
) %>%
distinct(
USUBJID,
TRT01A,
AEDECOD
) %>%
count(
AEDECOD,
name = "PATIENTS"
) %>%
arrange(
desc(PATIENTS)
)
teae_term_patients
teae_term_summary <- teae_terms %>%
left_join(
teae_term_patients,
by = "AEDECOD"
) %>%
arrange(
desc(PATIENTS),
desc(EVENTS)
)
teae_term_summary
teae_term_by_treatment <- adae %>%
filter(
TRTEMFL == "Y"
) %>%
distinct(
USUBJID,
TRT01A,
AEDECOD
) %>%
count(
AEDECOD,
TRT01A,
name = "PATIENTS"
)
teae_term_by_treatment
top10_teae <- teae_term_summary %>%
slice_max(
order_by = PATIENTS,
n = 10,
with_ties = FALSE
)
top10_teae
top10_teae_table <- teae_term_by_treatment %>%
filter(
AEDECOD %in% top10_teae$AEDECOD
) %>%
select(
AEDECOD,
TRT01A,
PATIENTS
) %>%
pivot_wider(
names_from = TRT01A,
values_from = PATIENTS,
values_fill = 0
) %>%
left_join(
top10_teae %>%
select(
AEDECOD,
EVENTS,
PATIENTS
),
by = "AEDECOD"
) %>%
arrange(
desc(PATIENTS)
)
top10_teae_table
write_csv(
top10_teae_table,
here(
"output",
"tables",
"04_teae_by_preferred_term.csv"
)
)
cat(
"Saved: output/tables/04_teae_by_preferred_term.csv\n"
)
teae_term_plot_data <- top10_teae %>%
mutate(
AEDECOD = fct_reorder(
AEDECOD,
PATIENTS
)
)
teae_term_plot <- ggplot(
teae_term_plot_data,
aes(
x = AEDECOD,
y = PATIENTS
)
) +
geom_col(
width = 0.7
) +
geom_text(
aes(
label = PATIENTS
),
hjust = -0.2,
size = 3.5
) +
coord_flip() +
scale_y_continuous(
expand = expansion(
mult = c(0, 0.12)
)
) +
labs(
title = "Top 10 Treatment-Emergent Adverse Events",
subtitle = "Ranked by number of affected patients",
x = "Preferred Term",
y = "Patients"
) +
theme_minimal(
base_size = 13
)
teae_term_plot
ggsave(
filename = here(
"output",
"figures",
"03_top_teae_preferred_terms.png"
),
